# =============================================================
# 环境变量示例文件
# 使用方法：把这个文件复制一份并重命名为 .env，然后填入你自己的 Supabase 信息
#   macOS / Linux： cp .env.example .env
#   Windows      ： copy .env.example .env
# 注意：.env 里面有密钥，绝对不要上传到 GitHub（.gitignore 已经帮你忽略了）
# =============================================================

# Supabase 项目地址（Project Settings → Data API → Project URL）
# 形如：https://abcdefghijklmno.supabase.co
SUPABASE_URL=

# Supabase 的 Publishable key（Project Settings → API Keys）
# 形如：sb_publishable_xxxxxxxxxxxxxxxx
# 千万不要用 sb_secret_... 开头的密钥
SUPABASE_ANON_KEY=

# 本地服务端口（可选，默认 3000；Vercel 上无需配置）
PORT=3000
