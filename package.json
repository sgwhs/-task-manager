{
  "name": "smart-task-manager",
  "version": "1.0.0",
  "private": true,
  "description": "智能任务管理系统 · React + Node.js(Express) + Supabase 云端数据库",
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"nodemon server/index.js\" \"vite\"",
    "dev:api": "nodemon server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && node server/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.7",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=18"
  }
}
